# ============================================================
# 根级 .gitignore —— 多业务线系统（biz-os）+ ONLYSTYLE 官网（website）
# ============================================================

# ----- 依赖 -----
node_modules/

# ----- 构建产物 -----
website/dist/

# ----- 设计工作区：架构文档 / 设计稿 / 效果图 / 审计截图（约 83 MB）-----
# 只留在本地，不进库以保持仓库轻快。
# 若要把架构文档一起纳入版本管理，删掉下面这行、改用：
#   design/
#   !design/*.md
#   !design/mockups/*.html
design/

# ----- 数据库：含 content_token 与业务数据，绝不入库 -----
biz-os/backend/*.db
biz-os/backend/*.db.*
# ⚠️ 上传目录的忽略规则只在 biz-os/.gitignore 里管（含「品牌图形例外放行」）。
#    此处不要重复写 biz-os/backend/uploads/ ——
#    ① 两处同管容易漏改；② 外层写 uploads/ 排除整个目录后，
#    内层的 !例外 会被一起废掉（git 不进被排除的目录）。详见 biz-os/.gitignore。

# ----- WorkBuddy 工具状态（会话记录 / 记忆 / 临时；记忆文件内含令牌）-----
.workbuddy/

# ----- 浏览器 profile 与本地临时 -----
.diag-profile*/
.chrome-profile/
outputs/
*.local

# ----- 日志 -----
*.log
npm-debug.log*
yarn-error.log*

# ----- 编辑器 / 系统 -----
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# ----- 部署：私钥与真实配置，绝不入库 -----
deploy/.ssh/
deploy/deploy.config.txt

# ----- 旧版 nginx Basic Auth 口令文件 -----
# 里面是密码哈希；即便防护已废弃也不该入库。
# （现网后台鉴权走应用层：登录 token + lib/admin-auth.js，不再用 nginx 口令）
onlystyle.htpasswd
onlystyle1.htpasswd

# ----- 备份与内容同步快照 -----
# backups/ 里有 DB 整库拷贝（含 content_token / 微信密钥等），属敏感数据，
# 与 biz-os/backend/*.db 同理，绝不入库。
backups/

# ----- 杂项：shell 重定向误产生的垃圾文件 -----
$null

# ----- 临时下载区（把文件取到本机仓库用，用完即可删）-----
_sync-to-local/
_sync-to-local.tar.gz

# ----- Vite 构建残留的临时配置（时间戳命名，每次构建可能生成）-----
website/vite.config.js.timestamp-*.mjs

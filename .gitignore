# ============================================================
# 根级 .gitignore —— 多业务线系统（biz-os）+ ONLYSTYLE 官网（website）
# ============================================================

# ----- 依赖 -----
node_modules/

# ----- 构建产物 -----
website/dist/

# ----- 设计工作区：架构文档 / 设计稿 / 效果图 / 审计截图（约 83 MB）-----
# 只留在本地，不进库以保持仓库轻快。
# 若要把架构文档一起纳入版本管理，删掉下面这行、改用：
#   design/
#   !design/*.md
#   !design/mockups/*.html
design/

# ----- 数据库 -----
# 2026-09-19 起主库入库：用户自部署服务器（www.onlystyle.com.cn）靠 git pull
# 同步内容中台数据 —— 菜单删除记录 / 导航 / logo 配置 / 页面内容全在
# broadband_os.db 里，不入库服务器内容就是旧的。
# 历史备份（*.db.*）仍不入库。仓库为私有；若将来转公开，先轮换
# content_settings.admin.content_token 再推。
biz-os/backend/*.db
biz-os/backend/*.db.*
!biz-os/backend/broadband_os.db
# ⚠️ 上传目录的忽略规则只在 biz-os/.gitignore 里管（含「品牌图形例外放行」）。
#    此处不要重复写 biz-os/backend/uploads/ ——
#    ① 两处同管容易漏改；② 外层写 uploads/ 排除整个目录后，
#    内层的 !例外 会被一起废掉（git 不进被排除的目录）。详见 biz-os/.gitignore。

# ----- WorkBuddy 工具状态（会话记录 / 记忆 / 临时；记忆文件内含令牌）-----
.workbuddy/

# ----- 浏览器 profile 与本地临时 -----
.diag-profile*/
.chrome-profile/
outputs/
*.local

# ----- 日志 -----
*.log
npm-debug.log*
yarn-error.log*

# ----- 编辑器 / 系统 -----
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# ----- 部署：私钥与真实配置，绝不入库 -----
deploy/.ssh/
deploy/deploy.config.txt

# ----- 杂项：shell 重定向误产生的垃圾文件 -----
$null
